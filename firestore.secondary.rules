// deploy ไฟล์นี้กับโปรเจกต์ SECONDARY เท่านั้น (เก็บ attendance / finance)
//
// ⚠️ ข้อจำกัดสำคัญ: Firestore Security Rules อ่านข้ามโปรเจกต์ไม่ได้ ดังนั้นโปรเจกต์นี้
// ต้องมี collection "users" ของตัวเอง (มินิมอล เก็บแค่ field "role") มิเรอร์คู่กับ
// โปรเจกต์ primary ไว้เช็คสิทธิ์แอดมิน — สร้างพร้อมกันตอนแอดมินเพิ่มนักเรียนใหม่
// (ดู SETUP.md ข้อ 3 "สร้างบัญชีคู่แฝด")
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn(){ return request.auth != null; }
    function myRole(){ return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin(){ return signedIn() && myRole() == 'admin'; }

    // เก็บแค่ { role: 'admin' | 'student' } พอ ไม่ต้อง sync ฟิลด์อื่นจาก primary
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if false; // แก้ผ่าน Firebase Console/สคริปต์แอดมินเท่านั้น ห้ามแก้จาก client
    }

    match /attendance/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /finance/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
  }
}
